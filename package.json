{
  "name": "sig-analytics",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @sig/db generate",
    "db:migrate": "pnpm --filter @sig/db migrate",
    "db:studio": "pnpm --filter @sig/db studio",
    "db:seed": "pnpm --filter @sig/db seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
