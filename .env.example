# Database
DATABASE_URL=postgres://sig:sig@127.0.0.1:5432/sig_analytics

# API
API_PORT=3000
PANEL_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth — generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Seed admin (pnpm db:seed)
SEED_ADMIN_FULL_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sosintelegent.local
SEED_ADMIN_PASSWORD=change-me-please

# apidirect.io — sinkron analitik X, TikTok, Instagram
APIDIRECT_API_KEY=
APIDIRECT_BASE_URL=https://apidirect.io

# Kunci enkripsi untuk pengaturan rahasia di DB (API key integrasi). JANGAN diganti setelah dipakai.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SETTINGS_ENCRYPTION_KEY=
